---
import { PostService } from '../../../service/post/fetch/postServicer';
import type { PostCardWithThumbnail } from '../../../service/post/types/PostServicer';
import ColDirectionPost from './ColDirectionPost.astro';
import Tags from './Tags.astro';
import Footer from '../../layouts/Footer.astro';

interface Props {
  currentSlug: string;
  tags: string[];
  relatedPosts: PostCardWithThumbnail[];
}

const { currentSlug, tags, relatedPosts } = Astro.props;

// 매칭 0건 시 폴백: 최근 포스트 (현재 글 제외, 최대 6개)
let displayPosts = relatedPosts;
let isMatchingEmpty = false;

if (relatedPosts.length === 0) {
  isMatchingEmpty = true;
  const allPosts = await PostService.getPublishedPosts();
  const fallbackPosts = allPosts
    .filter((post) => post.slug !== currentSlug)
    .slice(0, 6)
    .map((post) => PostService.convertToSummaryMapper(post))
    .filter((card): card is PostCardWithThumbnail => card !== null);
  displayPosts = fallbackPosts;
}

// 태그 → 대문자 + 오타 교정 (Figma PHILOSPPY → PHILOSOPHY)
const tagsNormalized = tags.map((tag) => {
  const upper = tag.toUpperCase();
  return upper === 'PHILOSPPY' ? 'PHILOSOPHY' : upper;
});

const heading = isMatchingEmpty ? '이런 글은 어때요?' : '같은 카테고리, 다른 글';
const description = isMatchingEmpty
  ? '최근에 올린 글들을 소개해요'
  : '카테고리가 2개 이상 겹치는 글들을 모아보았어요!';
---

<section id="related-posts" class="related-posts">
  {/* post-grid-text-package: 카드 타이포 규칙(.post-title 등)의 조상 스코프 — 없으면 weight가 풀림 */}
  <div class="related-posts-inner post-grid-text-package">
    {!isMatchingEmpty && <Tags tags={tagsNormalized.slice(0, 4)} />}

    <div class="related-posts-content">
      <h2 class="related-posts-title">{heading}</h2>
      <p class="related-posts-description">{description}</p>
    </div>

    {/* grid 유틸은 PostGridLayout col variant와 동일 — 없으면 li가 전체 폭이라 카드 밖 hover가 걸림 */}
    <ul class="related-posts-grid post-grid grid justify-items-center grid-cols-1 gap-y-7 sm:gap-x-6 lg:gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      {displayPosts.map((card) => (
        <li class="post-item py-1 px-1 rounded-[1px] transition-all duration-150 ease-in-out hover:-translate-y-1">
          <ColDirectionPost {...card} />
        </li>
      ))}
    </ul>
  </div>

  {/* 게이트 불변식: 푸터는 #related-posts 섹션 '내부' 마지막 자식 — data-collapsed(overflow:hidden)일 때
      함께 접혀 "경계 아래 스크롤 콘텐츠 0"을 유지. 섹션 뒤 형제로 두면 불변식이 깨진다. */}
  <Footer />
</section>

<style>
  .related-posts {
    width: 100%;
    min-height: calc(100dvh - var(--header-h)); /* 풀뷰포트 섹션 — 콘텐츠가 더 크면 자연 확장 */
    background-color: var(--color-bg-elevated);
    /* 상단 88px = 관련 포스트 헤더의 상단 여백(게이트 컨트롤은 in-flow라 자체 마진이 간격을 소유) */
    padding: 88px calc(23px * var(--root-scale, 1)) calc(48px * var(--root-scale, 1));
    border-top: 1px solid var(--color-border-primary);
  }

  /* 게이트 통과 전 수납 — 스크롤 컨테이너에 height 0으로 기여(경계 아래 콘텐츠 제거).
     그러면 아래로의 오버스크롤을 브라우저 네이티브 클램프가 막아 바운스가 구조적으로 불가능.
     JS(scrollGateObserver)가 data-collapsed를 토글한다. 높이 transition 없음 —
     전개는 snap 스크롤 tween이 담당하고, 여기서 height 애니메이션을 걸면 tween과 경합한다. */
  .related-posts[data-collapsed] {
    min-height: 0;
    height: 0;
    padding-top: 0;
    padding-bottom: 0;
    border-top-width: 0;
    overflow: hidden;
  }

  .related-posts-inner {
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
  }

  /* 자식 결합자(>) 필수 — 후손 셀렉터면 카드 내부 tags-wrapper까지 매칭돼 tag↔title이 벌어짐 */
  .related-posts-inner > :global(.tags-wrapper) {
    margin-top: 0;
    margin-bottom: calc(32px * var(--root-scale, 1));
  }

  .related-posts-content {
    margin-bottom: calc(48px * var(--root-scale, 1));
  }

  /* .grid-title과 동일 레시피 — 다른 라우트의 그리드 헤더와 통일 */
  .related-posts-title {
    font-size: var(--size-post-grid-title);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: 2px;
  }

  .related-posts-description {
    font-size: var(--size-post-description);
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* 푸터는 섹션 내부 마지막 자식 — 그리드와의 간격만 부여(수납 시 함께 접힘) */
  .related-posts > :global(.site-footer) {
    margin-top: calc(48px * var(--root-scale, 1));
  }

  /* 카드 그리드 (2x3, col-post-card 스케일 override) */
  .related-posts-grid .post-item {
    /* col-post-card --card-scale override: 260px × 1.3 = 338px (Figma Big Card) */
    --card-scale: 1.3;
  }

  @media (width < 768px) {
    .related-posts {
      padding: 88px calc(28px * var(--root-scale, 1)) calc(48px * var(--root-scale, 1));
    }
  }
</style>
