<script is:inline>
  // SMIL은 CSS로 정지 불가 — reduced-motion/탭 비활성 시 pauseAnimations()로 직접 제어 (WCAG 2.3.3)
  (() => {
    const svg = document.querySelector("svg.twisted-grid-motion");
    if (!svg || typeof svg.pauseAnimations !== "function") return;
    const mq = matchMedia("(prefers-reduced-motion: reduce)");
    const apply = () => {
      if (mq.matches || document.hidden) svg.pauseAnimations();
      else svg.unpauseAnimations();
    };
    mq.addEventListener("change", apply);
    document.addEventListener("visibilitychange", apply);
    apply();
  })();
</script>
