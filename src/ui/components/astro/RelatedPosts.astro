---
import { Icon } from 'astro-icon/components';
import { PostService } from '../../../service/post/fetch/postServicer';
import type { PostCardWithThumbnail } from '../../../service/post/types/PostServicer';
import ColDirectionPost from './ColDirectionPost.astro';

interface Props {
  currentSlug: string;
  tags: string[];
  relatedPosts: PostCardWithThumbnail[];
}

const { currentSlug, tags, relatedPosts } = Astro.props;

// 매칭 0건 시 폴백: 최근 포스트 (현재 글 제외, 최대 6개)
let displayPosts = relatedPosts;
let isMatchingEmpty = false;

if (relatedPosts.length === 0) {
  isMatchingEmpty = true;
  const allPosts = await PostService.getPublishedPosts();
  const fallbackPosts = allPosts
    .filter((post) => post.slug !== currentSlug)
    .slice(0, 6)
    .map((post) => PostService.convertToSummaryMapper(post))
    .filter((card): card is PostCardWithThumbnail => card !== null);
  displayPosts = fallbackPosts;
}

// 태그 → 대문자 + 오타 교정 (Figma PHILOSPPY → PHILOSOPHY)
const tagsNormalized = tags.map((tag) => {
  const upper = tag.toUpperCase();
  return upper === 'PHILOSPPY' ? 'PHILOSOPHY' : upper;
});
---

<section id="related-posts" class="related-posts">
  <div class="related-posts-header">
    <a href="/posts" class="related-posts-back">
      <Icon name="arrow_left" class="related-posts-arrow" />
      <span>BACK TO POSTS</span>
    </a>
  </div>

  {/* 매칭 성공 케이스: 카테고리 칩 표시 */}
  {!isMatchingEmpty && (
    <>
      <div class="related-posts-categories">
        {tagsNormalized.slice(0, 4).map((tag) => (
          <div class="category-chip">{tag}</div>
        ))}
      </div>

      <div class="related-posts-content">
        <h2 class="related-posts-title">같은 카테고리, 다른 글</h2>
        <p class="related-posts-description">
          카테고리가 2개 이상 겹치는 글들을 모아보았어요!
        </p>
      </div>
    </>
  )}

  {/* 매칭 실패 케이스: 폴백 분기 */}
  {isMatchingEmpty && (
    <div class="related-posts-content">
      <h2 class="related-posts-title">이런 글은 어때요?</h2>
      <p class="related-posts-description">
        최근에 올린 글들을 소개해요
      </p>
    </div>
  )}

  {/* 카드 그리드 (2x3) */}
  <ul class="related-posts-grid post-grid">
    {displayPosts.map((card) => (
      <li class="post-item py-1 px-1 rounded-[1px] transition-all duration-150 ease-in-out hover:-translate-y-1">
        <ColDirectionPost {...card} />
      </li>
    ))}
  </ul>

  {/* 관련 포스트 섹션 상단 센티널 — scrollGateObserver가 위로 스크롤 시 재진입 감지 */}
  <div id="related-posts-top-sentinel" class="h-px w-full" aria-hidden="true"></div>
</section>

<style>
  .related-posts {
    width: 100%;
    background-color: var(--color-bg-primary);
    padding: calc(96px * var(--root-scale, 1)) calc(23px * var(--root-scale, 1));
    border-top: 1px solid var(--color-border-primary);
  }

  .related-posts-header {
    max-width: 1100px;
    margin: 0 auto calc(48px * var(--root-scale, 1));
  }

  .related-posts-back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 150ms ease-out;
  }

  .related-posts-back:hover {
    color: var(--color-brand-hover);
  }

  .related-posts-arrow {
    width: 16px;
    height: 16px;
  }

  /* 카테고리 칩 (매칭 성공 케이스만) */
  .related-posts-categories {
    max-width: 1100px;
    margin: 0 auto calc(32px * var(--root-scale, 1));
    display: flex;
    flex-wrap: wrap;
    gap: calc(8px * var(--root-scale, 1));
  }

  .category-chip {
    display: inline-block;
    padding: calc(4px * var(--root-scale, 1)) calc(10px * var(--root-scale, 1));
    border: 1px solid var(--color-border-control);
    border-radius: 4px;
    background-color: var(--color-bg-pure);
    font-size: calc(11px * var(--root-scale, 1));
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .related-posts-content {
    max-width: 1100px;
    margin: 0 auto calc(48px * var(--root-scale, 1));
  }

  .related-posts-title {
    font-size: calc(21px * var(--root-scale, 1));
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: calc(8px * var(--root-scale, 1));
  }

  .related-posts-description {
    font-size: calc(10px * var(--root-scale, 1));
    color: var(--color-text-tertiary);
    margin: 0;
  }

  /* 카드 그리드 (2x3, col-post-card 스케일 override) */
  .related-posts-grid {
    max-width: 1100px;
    margin: 0 auto;
  }

  .related-posts-grid .post-item {
    /* col-post-card --card-scale override: 260px × 1.3 = 338px (Figma Big Card) */
    --card-scale: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    .related-posts-back {
      transition: none;
    }
  }

  {/* 모바일 대응: 카드 폭 100%, 칩 크기 축소 */}
  @media (width < 768px) {
    .related-posts {
      padding: calc(48px * var(--root-scale, 1)) calc(28px * var(--root-scale, 1));
    }

    .category-chip {
      font-size: 10px;
    }

    .related-posts-title {
      font-size: 16px;
    }

    .related-posts-description {
      font-size: 12px;
    }
  }
</style>
