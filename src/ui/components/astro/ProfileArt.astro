---
// 프로필 히어로 패널 — Figma 3917:741. 치수/타이포는 root.css의 --root-* 토큰이 통제.
// 로고타입·연락처는 ProfileLogotype/ProfileContacts로 추출(about 히어로와 공유). 마크업·클래스 불변.
import TwistedGridMotion from "./TwistedGridMotion.astro";
import ProfileLogotype from "./ProfileLogotype.astro";
import ProfileContacts from "./ProfileContacts.astro";
---
<div class="profile-art">
  <a class="profile-art-cover" href="/about" aria-label="About 페이지로 이동"></a>
  <div class="twisted-art" aria-hidden="true">
    <TwistedGridMotion />
  </div>
  <span class="art-rail" aria-hidden="true">
    <svg class="rail-arrow" viewBox="0 0 12 12" fill="none">
      <path d="M2.5 9.5L9.5 2.5M9.5 2.5H3.5M9.5 2.5V8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/>
    </svg>
    <span class="rail-label">/ABOUT</span>
  </span>

  <div class="profile-body">
    <p class="profile-quote">“Towards,<br />What Lies Beyond Development”</p>

    <ProfileLogotype />

    <ProfileContacts />
  </div>
</div>
