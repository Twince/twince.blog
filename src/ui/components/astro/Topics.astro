---
// 토픽 칩 밴드 — Figma 3917:772 (root v2 히어로 우측 하단, 모바일 4114:1217~)
// 탐색 축 = SERIES(고정 진입 칩) + topics 컬렉션(통제된 상위 분류).
// 데스크탑: /EXPLORE 레일 + 3열 그리드(설명 포함) / 모바일: 가로 스크롤(이름만).
import { getCollection } from "astro:content";

const topics = await getCollection("topics");

// TODO(사용자): 칩 라우팅 결정 시 <li>를 <a>로 교체
const chips = topics.map((topic) => ({
  id: topic.data.id,
  title: topic.data.title,
  description: topic.data.description,
}));
---
<div class="topics-band">
  <span class="explore-rail" aria-hidden="true"><span class="rail-label">EXPLORE</span></span>
  <ul class="topics-grid">
    {chips.map((chip) => (
      <li class="topic-chip">
        <span class="topic-hash" aria-hidden="true">#</span>
        <div>
          <p class="topic-name">{chip.title}</p>
          <p class="topic-desc">{chip.description}</p>
        </div>
      </li>
    ))}
  </ul>
</div>
