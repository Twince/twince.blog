---
import BaseLayout from "../ui/layouts/BaseLayout.astro";
const presentationUrl = "/slides/frame.html";
---

<BaseLayout>
  <section class="slides-page" aria-label="발표 자료">
    <div class="slides-toolbar">
      <h1>FRAME <span>야간비행</span></h1>
      <div class="slides-actions">
        <a href={presentationUrl} target="_blank" rel="noopener">발표 화면 열기 ↗</a>
        <a href={presentationUrl} download="FRAME_야간비행_발표.html">HTML 내려받기 ↓</a>
      </div>
    </div>
    <iframe
      class="slides-viewer"
      src={presentationUrl}
      title="FRAME · 야간비행 인터랙티브 발표"
      allow="fullscreen"
      allowfullscreen
    ></iframe>
  </section>
</BaseLayout>

<style>
  .slides-page { display: flex; flex-direction: column; height: 100%; min-height: 0; }
  .slides-toolbar {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    gap: 12px 24px; padding: 16px 24px;
    border-bottom: 1px solid var(--color-border-primary);
  }
  h1 { margin: 0; font-size: 17px; font-weight: 600; color: var(--color-text-primary); }
  h1 span { margin-left: 10px; font-size: 14px; font-weight: 400; color: var(--color-text-quaternary); }
  .slides-actions { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 13px; }
  .slides-actions a { color: var(--color-text-primary); text-underline-offset: 4px; }
  .slides-actions a:hover { text-decoration: underline; }
  .slides-actions a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .slides-viewer { display: block; width: 100%; flex: 1; min-height: 0; border: 0; background: #000; }
  @media (max-width: 767px) { .slides-toolbar { padding: 12px 16px; } }
</style>

<script>
  const viewer = document.querySelector<HTMLIFrameElement>(".slides-viewer");
  viewer?.addEventListener("load", () => viewer.contentWindow?.focus());
</script>
