---
// ROOT 랜딩 — Figma root v2(3917:491) + mobile(4114:883)
// 서사: 정체성(프로필) → 대표작(시리즈) → 탐색축(토픽) → 최신 글(피드)
import BaseLayout from "../BaseLayout.astro"
import ProfileArt from "../../components/astro/ProfileArt.astro"
import Topics from "../../components/astro/Topics.astro"
import SeriesLayouts from "./SeriesLayouts.astro"
import PostGridLayout from "../post-grid/PostGridLayout.astro"
import Footer from "../Footer.astro"
import { SeriesService } from "../../../service/post/fetch/seriesServicer"

// 실데이터: getSeriesCards() (series.json + 역참조 postCount 집계). MOCK 제거 완료.
const series = await SeriesService.getSeriesCards();

// TODO(사용자 EDGE): 최근 포스트 개수 제한(limit prop vs 래퍼) — 시안은 최신 4개
---
<BaseLayout>
  <div class="root-page h-full overflow-y-auto no-scrollbar">
    <section class="root-hero">
      <div class="root-hero-inner">
        <ProfileArt />
        <div class="root-hero-right flex flex-col">
          <SeriesLayouts series={series} />
          <Topics />
        </div>
      </div>
    </section>

    <section class="root-recent post-grid-text-package">
      <h2 class="root-section-title">최근 포스트</h2>
      <PostGridLayout direction="row" />
    </section>

    <Footer />
  </div>
</BaseLayout>
