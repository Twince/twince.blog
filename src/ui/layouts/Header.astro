---
import GoToMain from "../components/astro/GoToMain.astro"
import GlobalNavigation from "../components/astro/GlobalNavigation.astro"
import ThemeToggle from "../components/astro/ThemeToggle.astro"
---

<header class="w-full sticky top-0 z-40 bg-bg-primary border-b-1 border-border-primary">
  {/* desktop (md+): 로고 | 내비+토글 — 인셋은 GoToMain mx-2가 담당 */}
  <div class="hidden md:flex mx-auto max-w-[1100px] h-[var(--header-h)] items-center justify-between">
    <GoToMain />
    <div class="flex items-center gap-10">
      <GlobalNavigation />
      <ThemeToggle />
    </div>
  </div>

  {/* mobile (<md): 로고 | 토글+햄버거 */}
  <div class="md:hidden h-[var(--header-h)] px-4 flex items-center justify-between">
    <GoToMain />
    <div class="flex items-center gap-2">
      <ThemeToggle />
      <button
        data-nav-toggle
        type="button"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="hamburger"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

{/* 모바일 메뉴: 헤더 아래로 fixed 슬라이드 다운 */}
<div id="mobile-menu" class="mobile-menu md:hidden" data-open="false">
  <GlobalNavigation vertical />
</div>

<style>
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 32px;
    height: 32px;
  }
  .hamburger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background-color: var(--color-text-primary);
    transition: transform 250ms cubic-bezier(0.2, 0, 0, 1), opacity 200ms ease-out;
  }
  /* 열림: 3선 → X 모프 */
  .hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-menu {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    z-index: 30; /* 헤더(z-40) 아래 */
    padding: 24px 28px;
    background-color: var(--color-bg-primary);
    border-bottom: 1px solid var(--color-border-primary);
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    transition: opacity 200ms ease-out, transform 200ms cubic-bezier(0.2, 0, 0, 1),
                visibility 0s linear 200ms;
  }
  .mobile-menu[data-open="true"] {
    opacity: 1;
    transform: translateY(0);
    visibility: visible;
    transition-delay: 0s;
  }
</style>

<script>
  const toggle = document.querySelector("[data-nav-toggle]");
  const menu = document.getElementById("mobile-menu");

  function setOpen(open: boolean) {
    menu?.setAttribute("data-open", String(open));
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "메뉴 닫기" : "메뉴 열기");
  }
  const isOpen = () => menu?.getAttribute("data-open") === "true";

  toggle?.addEventListener("click", () => setOpen(!isOpen()));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen()) setOpen(false);
  });
</script>
