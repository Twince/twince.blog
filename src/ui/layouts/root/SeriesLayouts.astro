---
// 시리즈 쇼케이스(3열) — Figma 3917:805
import { Image } from "astro:assets";
import type { SeriesCardSummary } from "../../../service/post/types/SeriesServicer";

interface Props {
  series: SeriesCardSummary[];
}
const { series } = Astro.props;
---
<div class="series-showcase">
  {series.map((item, index) => (
    <a class="series-col" href={`/series/${item.id}`}>
      <svg class="series-arrow" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M2.5 9.5L9.5 2.5M9.5 2.5H3.5M9.5 2.5V8.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/>
      </svg>
      <span class="series-label">시리즈 #{index + 1}</span>
      <h2 class="series-title">{item.title}</h2>
      <span class="series-count">
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
          <path d="M2 1.5H8M2 3.5H8M2 5.5H8M2 7.5H5.5" stroke="currentColor" stroke-width="1"/>
        </svg>
        총 {item.count}개의 포스트
      </span>
      {item.thumbnail ? (
        <div class="series-thumb-wrap" aria-hidden="true">
          {/* 2레이어 크로스페이드: 아래=원색, 위=지면 duotone. url() 필터는 CSS 보간이 안 되어
              hover 해금을 mono 레이어 opacity 페이드로 처리. 같은 src라 네트워크 비용 0(캐시 공유). */}
          <Image
            src={item.thumbnail.src}
            alt=""
            class="series-thumb series-thumb-color"
            widths={[336, 672]}
            sizes="336px"
          />
          <Image
            src={item.thumbnail.src}
            alt=""
            class="series-thumb series-thumb-mono"
            widths={[336, 672]}
            sizes="336px"
          />
        </div>
      ) : (
        <p class="series-desc">{item.description}</p>
      )}
    </a>
  ))}
</div>

{/* 윤곽 추출 필터 — 썸네일을 라인 드로잉으로(TwistedGrid 와이어프레임과 같은 언어).
    체인: 무채색화 → 블러(질감 노이즈 억제) → 라플라시안(윤곽 응답) → 증폭 → 색 매핑.
    다크 = 어두운 지면 위 밝은 선, 라이트 = 밝은 지면 위 잉크 선(램프 반전). CSS가 테마 선택.
    노브: slope(선 강도), stdDeviation(노이즈 vs 디테일), 마지막 tableValues(지면/선 색). */}
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="thumb-edge-dark" color-interpolation-filters="sRGB">
    <feColorMatrix type="saturate" values="0" />
    <feGaussianBlur stdDeviation="1" />
    <feConvolveMatrix order="3" kernelMatrix="-1 -1 -1 -1 8 -1 -1 -1 -1" preserveAlpha="true" />
    <feComponentTransfer>
      <feFuncR type="linear" slope="2.4" />
      <feFuncG type="linear" slope="2.4" />
      <feFuncB type="linear" slope="2.4" />
    </feComponentTransfer>
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0.10 0.90" />
      <feFuncG type="table" tableValues="0.10 0.88" />
      <feFuncB type="table" tableValues="0.10 0.84" />
    </feComponentTransfer>
  </filter>
  <filter id="thumb-edge-light" color-interpolation-filters="sRGB">
    <feColorMatrix type="saturate" values="0" />
    <feGaussianBlur stdDeviation="1" />
    <feConvolveMatrix order="3" kernelMatrix="-1 -1 -1 -1 8 -1 -1 -1 -1" preserveAlpha="true" />
    <feComponentTransfer>
      <feFuncR type="linear" slope="2.4" />
      <feFuncG type="linear" slope="2.4" />
      <feFuncB type="linear" slope="2.4" />
    </feComponentTransfer>
    <feComponentTransfer>
      <feFuncR type="table" tableValues="0.95 0.32" />
      <feFuncG type="table" tableValues="0.94 0.31" />
      <feFuncB type="table" tableValues="0.92 0.30" />
    </feComponentTransfer>
  </filter>
</svg>
