---
import GoToMain from "../components/astro/GoToMain.astro"
import GlobalNavigation from "../components/astro/GlobalNavigation.astro"
import ThemeToggle from "../components/astro/ThemeToggle.astro"
---

<header class="w-full sticky top-0 z-40 bg-bg-primary border-b-1 border-border-primary">
  {/* desktop (md+): 로고 | 내비+토글 한 줄 */}
  {/* px 없음: 로고가 콘텐츠 컬럼 모서리(Figma 416≈413+3)에 근접 정렬 — 인셋은 GoToMain mx-2가 담당 */}
  <div class="hidden md:flex mx-auto max-w-[1100px] h-[var(--header-h)] items-center justify-between">
    <GoToMain />
    <div class="flex items-center gap-10">
      <GlobalNavigation />
      <ThemeToggle />
    </div>
  </div>

  {/* mobile (<md): 2단 — 로고+토글 / 내비 상시 노출 (Figma 4114:1201) */}
  <div class="md:hidden h-[var(--header-h)] px-4 py-3 flex flex-col justify-between">
    <div class="flex items-center justify-between">
      <GoToMain />
      <ThemeToggle />
    </div>
    <GlobalNavigation />
  </div>
</header>
