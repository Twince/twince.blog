---
import BaseLayout from "../ui/layouts/BaseLayout.astro";
const presentationUrl = "/slides/frame.html";
---

<BaseLayout>
  <section class="slides-page" aria-label="발표 자료">
    <div class="slides-toolbar">
      <h1>FRAME <span>야간비행</span></h1>
      <div class="slides-actions">
        <a href={presentationUrl} target="_blank" rel="noopener">발표 화면 열기 ↗</a>
        <a href={presentationUrl} download="FRAME_야간비행_발표.html">HTML 내려받기 ↓</a>
        <button class="slides-fullscreen" type="button" disabled title="발표 전체화면 · Esc로 종료">전체화면 <span aria-hidden="true">⛶</span></button>
      </div>
    </div>
    <div class="slides-stage" aria-busy="true">
      <div class="slides-loading" role="status" aria-live="polite">
        <span class="loading-spinner" aria-hidden="true"></span>
        <p class="loading-message">발표 자료를 불러오는 중…</p>
        <button class="slides-retry" type="button" hidden>다시 불러오기</button>
      </div>
      <iframe
        class="slides-viewer"
        src={presentationUrl}
        title="FRAME · 야간비행 인터랙티브 발표"
        allow="fullscreen"
        allowfullscreen
      ></iframe>
    </div>
    <p class="slides-notice" role="status" hidden></p>
  </section>
</BaseLayout>

<style>
  .slides-page { display: flex; flex-direction: column; height: 100%; min-height: 0; }
  .slides-toolbar {
    display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;
    gap: 12px 24px; padding: 16px 24px;
    border-bottom: 1px solid var(--color-border-primary);
  }
  h1 { margin: 0; font-size: 17px; font-weight: 600; color: var(--color-text-primary); }
  h1 span { margin-left: 10px; font-size: 14px; font-weight: 400; color: var(--color-text-quaternary); }
  .slides-actions { display: flex; flex-wrap: wrap; gap: 12px 24px; font-size: 13px; }
  .slides-actions a, .slides-actions button { color: var(--color-text-primary); text-underline-offset: 4px; }
  .slides-actions button { padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }
  .slides-actions button:disabled { opacity: .4; cursor: wait; }
  .slides-actions a:hover, .slides-actions button:not(:disabled):hover { text-decoration: underline; }
  .slides-actions a:focus-visible, .slides-actions button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .slides-stage { position: relative; isolation: isolate; flex: 1; min-height: 0; background: #000; }
  .slides-viewer { position: absolute; inset: 0; display: block; width: 100%; height: 100%; border: 0; background: #000; z-index: 0; }
  .slides-stage[aria-busy="true"] .slides-viewer, .slides-stage[data-error="true"] .slides-viewer { visibility: hidden; }
  .slides-viewer:fullscreen { width: 100vw; height: 100dvh; }
  .slides-loading { position: absolute; inset: 0; z-index: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 16px; color: #a8b1a8; }
  .slides-loading[hidden], .slides-retry[hidden], .slides-notice[hidden] { display: none; }
  .loading-message { margin: 0; font-size: 14px; }
  .loading-spinner { width: 22px; height: 22px; border: 1px solid #303832; border-top-color: #c6d7c8; border-radius: 50%; animation: loading-spin 1s linear infinite; }
  .slides-stage[data-error="true"] .loading-spinner { display: none; }
  .slides-retry { padding: 8px 12px; border: 1px solid #59655b; border-radius: 4px; color: #eff0eb; background: transparent; font: inherit; cursor: pointer; }
  .slides-notice { margin: 0; padding: 8px 24px; color: var(--color-text-primary); font-size: 13px; }
  @keyframes loading-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .loading-spinner { animation: none; } }
  @media (max-width: 767px) { .slides-toolbar { padding: 12px 16px; } }
</style>

<script>
  const viewer = document.querySelector<HTMLIFrameElement>(".slides-viewer");
  const stage = document.querySelector<HTMLElement>(".slides-stage");
  const loading = document.querySelector<HTMLElement>(".slides-loading");
  const message = document.querySelector<HTMLElement>(".loading-message");
  const retry = document.querySelector<HTMLButtonElement>(".slides-retry");
  const fullscreen = document.querySelector<HTMLButtonElement>(".slides-fullscreen");
  const notice = document.querySelector<HTMLElement>(".slides-notice");

  async function finishLoading() {
    if (!viewer || !stage || !loading || !message || !retry || !fullscreen) return;
    try {
      const document = viewer.contentDocument;
      if (!document?.querySelector("#deck .slide")) throw new Error("Presentation unavailable");
      await document.fonts.ready;
      loading.hidden = true;
      stage.setAttribute("aria-busy", "false");
      delete stage.dataset.error;
      fullscreen.disabled = false;
      if (window.document.activeElement === window.document.body) viewer.contentWindow?.focus();
    } catch {
      stage.setAttribute("aria-busy", "false");
      stage.dataset.error = "true";
      message.textContent = "발표 자료를 불러오지 못했습니다.";
      retry.hidden = false;
    }
  }

  viewer?.addEventListener("load", finishLoading);
  if (viewer?.contentDocument?.readyState === "complete" && viewer.contentWindow?.location.href !== "about:blank") finishLoading();
  retry?.addEventListener("click", () => {
    if (!viewer || !stage || !message) return;
    stage.setAttribute("aria-busy", "true");
    delete stage.dataset.error;
    retry.hidden = true;
    message.textContent = "발표 자료를 불러오는 중…";
    viewer.src = viewer.src;
  });
  fullscreen?.addEventListener("click", async () => {
    if (!viewer || !notice) return;
    try {
      notice.hidden = true;
      await viewer.requestFullscreen();
      viewer.contentWindow?.focus();
    } catch {
      notice.textContent = "전체화면을 사용할 수 없습니다. ‘발표 화면 열기’를 이용해 주세요.";
      notice.hidden = false;
    }
  });
</script>
