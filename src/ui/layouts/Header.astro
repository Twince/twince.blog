---
import GoToMain from "../components/astro/GoToMain.astro"
import GlobalNavigation from "../components/astro/GlobalNavigation.astro"
import ThemeToggle from "../components/astro/ThemeToggle.astro"
---

<header class="w-full sticky top-0 z-40 bg-bg-primary border-b-1 border-border-primary">
  <div class="mx-auto max-w-[1100px] h-16 flex items-center justify-between px-6">
    <GoToMain />

    {/* desktop (md+) */}
    <div class="hidden md:flex items-center gap-10">
      <GlobalNavigation />
      <ThemeToggle />
    </div>

    {/* mobile (<md): 토글 + 햄버거 */}
    <div class="flex md:hidden items-center gap-3">
      <ThemeToggle />
      <button
        id="nav-toggle"
        type="button"
        aria-label="메뉴 열기"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex flex-col justify-center items-center gap-[5px] size-8"
      >
        <span class="block w-5 h-[2px] bg-text-primary"></span>
        <span class="block w-5 h-[2px] bg-text-primary"></span>
        <span class="block w-5 h-[2px] bg-text-primary"></span>
      </button>
    </div>
  </div>

  {/* mobile 메뉴 패널 */}
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t-1 border-border-primary bg-bg-primary px-6 py-5"
  >
    <GlobalNavigation vertical />
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isHidden));
    toggle.setAttribute("aria-label", isHidden ? "메뉴 열기" : "메뉴 닫기");
  });
</script>
