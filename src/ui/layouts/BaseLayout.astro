---
import '../css/index.css'

import Footer from "./Footer.astro"
import Header from "./Header.astro"

const currentPath = Astro.url.pathname;

// const isInArticle = currentPath.includes('/posts') || currentPath.includes('/series')
---
<!doctype html>
<html lang="ko">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="X-UA-Compatible" content="ie=edge">
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>TWINCE.BLOG</title>
		<!-- FOUC 방지: 첫 페인트 전에 테마 결정(localStorage → prefers-color-scheme) -->
		<script is:inline>
			(() => {
				const t = localStorage.getItem("theme") ||
					(matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
				document.documentElement.dataset.theme = t;
			})();
		</script>
	</head>
	<body>
		<Header />
				<div class="w-auto h-[calc(100dvh-(--spacing(16)))] border-x-1 border-border-primary">
					<slot />
				</div>
		<Footer />
	</body>
</html>
