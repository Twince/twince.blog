---
// 테마 토글 — Radix Themes 스위치 문법: 뉴트럴 트랙 + 슬라이딩 썸 + 해/달 크로스페이드.
// 상태는 :root[data-theme]가 단일 출처(스크립트는 토글만, 시각은 CSS가 반응).
---

<button
  data-theme-toggle
  type="button"
  aria-label="테마 전환"
  class="theme-switch"
>
  <span class="switch-thumb" aria-hidden="true"></span>
  <span class="switch-icon icon-sun" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <circle cx="12" cy="12" r="4.5"></circle>
      <path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4L6 18M18 6l1.4-1.4"></path>
    </svg>
  </span>
  <span class="switch-icon icon-moon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"></path>
    </svg>
  </span>
</button>

<style>
  .theme-switch {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 52px;
    height: 26px;
    padding: 2px;
    flex-shrink: 0;
    border: 1px solid var(--color-border-primary);
    border-radius: 7px;
    background-color: var(--color-bg-primary);
    cursor: pointer;
    transition: border-color 150ms ease-out, background-color 150ms ease-out;
  }
  .theme-switch:hover { border-color: var(--color-border-control); }
  .theme-switch:focus-visible {
    outline: 2px solid var(--color-brand-hover);
    outline-offset: 2px;
  }

  /* 썸 중심(left 4 + 10)과 아이콘 슬롯 중심(2 + 24/2 = 14)을 일치시킴 */
  .switch-thumb {
    position: absolute;
    left: 4px;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background-color: var(--color-bg-pure);
    border: 1px solid var(--color-border-primary);
    box-shadow: 0 1px 2px color-mix(in srgb, var(--black) 10%, transparent);
    transform: translateX(0);
    transition: transform 250ms cubic-bezier(0.2, 0, 0, 1);
  }
  :global(:root[data-theme="dark"]) .switch-thumb { transform: translateX(24px); }
  .theme-switch:active .switch-thumb { scale: 0.92; }

  /* 아이콘 두 개가 트랙 좌/우 슬롯에 상주 — 활성 쪽만 진하고 커짐 */
  .switch-icon {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50%;
    height: 100%;
    color: var(--color-text-quaternary);
    transition: color 250ms ease-out, transform 250ms cubic-bezier(0.2, 0, 0, 1), opacity 250ms ease-out;
    transform: scale(0.82);
    opacity: 0.6;
  }
  .switch-icon svg { width: 12px; height: 12px; }

  /* 라이트: 해 활성 / 다크: 달 활성 */
  .icon-sun { color: var(--color-text-primary); transform: scale(1) rotate(0deg); opacity: 1; }
  :global(:root[data-theme="dark"]) .icon-sun {
    color: var(--color-text-quaternary);
    transform: scale(0.82) rotate(-90deg);
    opacity: 0.6;
  }
  :global(:root[data-theme="dark"]) .icon-moon {
    color: var(--color-text-primary);
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
  .icon-moon { transform: scale(0.82) rotate(90deg); }
</style>

<script>
  // 헤더가 데스크탑/모바일 블록에 토글을 각각 렌더 → id 대신 data 속성으로 전부 바인딩
  const root = document.documentElement;
  document.querySelectorAll("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const next = root.dataset.theme === "dark" ? "light" : "dark";
      root.dataset.theme = next;
      localStorage.setItem("theme", next);
    });
  });
</script>
